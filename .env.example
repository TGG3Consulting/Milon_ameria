NODE_ENV=development

SERVER_PORT=4000
CLIENT_ORIGIN=http://localhost:5173

BITRIX_CLIENT_ID=
BITRIX_CLIENT_SECRET=
BITRIX_REDIRECT_URI=
BITRIX_WEBHOOK_URL=
BITRIX_ALLOWED_DOMAINS=milonmining24.bitrix24.ru
BITRIX_REQUEST_TIMEOUT_MS=90000
BITRIX_SESSION_SECRET=
BITRIX_SESSION_COOKIE_NAME=milon_bitrix_session
BITRIX_SESSION_TTL_MS=3600000
BITRIX_INSTALLATION_STORE_PATH=data/bitrix-installations.json
# Optional emergency override; normally captured automatically during installation.
BITRIX_APPLICATION_TOKEN=
CLIENT_DIST_PATH=apps/client/dist

AMERIA_BASE_URL=
AMERIA_CLIENT_ID=
AMERIA_CLIENT_SECRET=
AMERIA_USERNAME=
AMERIA_PASSWORD=
AMERIA_AUTH_PATH=/oauth/token
AMERIA_AUTH_MODE=json
AMERIA_TRANSACTIONS_PATH=/transactions
AMERIA_SYNC_ENABLED=false
AMERIA_SYNC_RUN_ON_START=false
AMERIA_SYNC_INTERVAL_MS=300000
AMERIA_SYNC_FROM_DATE=2026-01-01
AMERIA_SCHEDULER_STATE_PATH=data/ameria-scheduler-state.json
ACTIVITY_LOG_PATH=data/activity-log.json

# Additive matching layer (smartMatch + parsePurposeV2). Legacy behaviour is unchanged while false.
SMART_MATCH_V2=false

